{
  "version": "0.2.0",
  "configurations": [


    {
      "name": "Q3 OpenGL (GLx / Win32)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\meson\\build\\win32\\fntech3.exe",
      "args": ["+set", "com_gameProfile", "q3", "+set", "fs_basepath", "${input:q3InstallPath}", "+set", "fs_homepath", "${workspaceFolder}\\.tmp\\vscode\\q3", "+set", "r_fullscreen", "0", "+set", "cl_renderer", "glx", "+set", "com_steamIntegration", "0"],
      "cwd": "${workspaceFolder}\\meson\\build\\win32",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Q3 Vulkan (VK / Win32)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\meson\\build\\win32\\fntech3.exe",
