  "inputs": [
    {
      "id": "q3InstallPath",
      "type": "promptString",
      "description": "Quake III Arena installation folder containing baseq3 (without quotes)",
      "default": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Quake 3 Arena"
    },
    {
      "id": "qlInstallPath",
      "type": "promptString",
      "description": "Quake Live installation folder containing baseq3 (without quotes)",
