      "cwd": "${workspaceFolder}\\meson\\build\\win32",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "QL Vulkan (VK / Steam / Retail / Win32)",
      "type": "cppvsdbg",
