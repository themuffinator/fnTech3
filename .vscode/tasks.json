      ],
      "problemMatcher": []
    },
    {
      "label": "Release: Runtime Sweep Win32 GLx",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}\\scripts\\glx_runtime_sweep.py",
        "--exe",
        "${workspaceFolder}\\meson\\build\\win32\\fntech3.exe",
        "--renderers",
        "glx,vk",
        "--switch-sequence",
        "glx,vk,glx,vk",
        "--maps",
        "q3dm1",
        "--profile",
        "glx-parity"
      ],
      "dependsOn": [
