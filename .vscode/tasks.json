  "tasks": [
    {
      "label": "meson: setup all games",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\build-release.ps1",
        "-Configuration",
        "RelWithDebInfo",
        "-Platform",
        "Win32",
        "-BuildDir",
        "meson\\build\\win32-dev",
        "-Target",
        "both",
        "-Renderers",
        "glx,vk,rtx",
        "-RTCWDevelopment",
        "-WolfETDevelopment",
        "-STVEFDevelopment",
        "-JKADevelopment",
        "-JK2Development",
        "-Q3IHVDevelopment",
        "-AliceDevelopment",
        "-FAKK2Development",
        "-MOHAADevelopment",
        "-Q3TestDevelopment",
        "-Archive",
        "-SetupOnly"
      ],
      "problemMatcher": [
        "$gcc",
        "$msCompile"
