# Auto detect text files and perform LF normalization
* text=auto

# Root-package map sidecars must be byte-stable across release hosts.
pkg/games/*/*/maps/*.azb binary
pkg/games/*/*/maps/*.fog text eol=lf
pkg/games/**/*.sndshd text eol=lf
pkg/games/**/*.shader text eol=lf
pkg/games/**/*.json text eol=lf

# Apple signing/notarization property lists require canonical LF text.
misc/macos/*.plist.in text eol=lf
misc/macos/*.entitlements text eol=lf

# freedesktop launcher templates are installed on Linux; keep them LF everywhere.
assets/icons/**/*.desktop text eol=lf
