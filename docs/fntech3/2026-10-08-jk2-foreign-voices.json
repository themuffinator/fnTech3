 "registration": {
  "call": "Cvar_Get(\"s_language\", \"english\", 0x401)",
  "S_Init": {
   "mp": "0x45ca1a (stored at [0x1a20c90], 0x45ca36)",
   "sp": "0x423350 (stored at [0xd3899c], 0x423369)"
  },
  "beforeS_InitSoundCheck": {
   "mp": "s_initsound registered at 0x45ca68",
   "sp": "s_initsound registered at 0x42339d"
  },
  "flag0x1": "archive: the config writer saves cvars with bit 1 (test byte [esi+0x10], 1 at mp 0x42b1f0, sp 0x416af0, beside the \"seta %s \\\"%s\\\"\" format)",
  "flag0x400": "CVAR_NORESTART: cvar_restart (mp 0x42b3b0, sp 0x416ca0; registered at mp 0x42b662, sp 0x416ee2) skips cvars with flags & 0x450 (ROM 0x40, INIT 0x10, 0x400) at mp 0x42b3c0, sp 0x416cb0",
  "fnTech3Flags": "CVAR_ARCHIVE 0x0001 and CVAR_NORESTART 0x0400 (code/qcommon/q_shared.h): the same bits",
  "menus": {
   "mp ui.qvm": "cvar table entry at data offset 0xdc4: s_language, \"english\", 0x401",
   "sp built-in UI_Init": "0x4994b0 (\"Bad UI_API_VERSION\"), Cvar_Get through the UI import table at 0x49953f: s_language, \"english\", 0x401"
  }
 },
 "loader": {
  "path": "S_RegisterSound (mp 0x45ce20, sp 0x423c20) and the sound starters (mp 0x45d2a7, 0x45d53c, 0x45d634; sp 0x423761, 0x424346, 0x424477, 0x42495a, 0x424a60) -> load helper (mp 0x45cf20, sp 0x423cf0) -> S_LoadSound (its only callers: mp 0x45cf26, sp 0x423cf6) -> file loader (mp 0x45f520 called only at 0x45f0d6; sp 0x42adb0 called only at 0x42a9da)",
  "find": "first \"chars\" by the CRT strstr, case-sensitive (mp 0x4d4fe0 called at 0x45f52f; sp 0x4b33f0 at 0x42adbf)",
  "language": "_stricmp(s_language->string, \"DEUTSCH\") then \"FRANCAIS\" (mp 0x4e2480 at 0x45f655, 0x45f685; sp 0x4c55f0 at 0x42aef4, 0x42af24); a missing cvar or any other value clears the substitution (mp 0x45f6a3, sp 0x42af42)",
  "substitute": "strncpy of 5 bytes, \"chr_d\" (mp 0x45f669, sp 0x42af08) or \"chr_f\" (mp 0x45f699, sp 0x42af38)",
  "order": "FS_ReadFile <name>.wav, then the last three characters overwritten with mp3 and read again (mp 0x45f6b1, 0x45f6dd..0x45f6eb; sp 0x42af50, 0x42af7c..0x42af8a); when both fail after a substitution: \"chars\" restored and English .wav then .mp3 (mp 0x45f707..0x45f748, sp 0x42afa6..0x42afe7)",
  "messages": "none: the release engines carry no string for a missing foreign recording",
  "case": {
   "mp": "S_LoadSound 0x45f050 writes \"%s.wav\" (0x4fddf0) on the stored name cut at its first \".\" (COM_StripExtension 0x434220); S_FindName 0x45cc00 stores names with Q_strncpyz (0x434620), unchanged in case: \"Chars\" is not found",
   "sp": "S_LoadSound 0x42a910 lowercases its copy with _strlwr (0x4c6323, called at 0x42a96a) before the loader: any case is found"
  },
  "buildScript": {
   "cvar": "com_buildScript pointer mp [0xaa1d88] (Cvar_Get at 0x429ccc), sp [0xa852b0] (0x4157d3)",
   "rule": "when set, opens and closes the chr_d and chr_f .wav, else .mp3, of every voice (mp 0x45f545..0x45f640, sp 0x42add5..0x42aee0)",
   "mpSlip": "mp restores \"chars\" but not \"wav\" after the French probe (0x45f633), so where the French .wav is missing the name continues ending .mp3; inferred, not run: an English-only WAV voice such as sound/chars/turret/move.wav then fails to load in such a run",
   "sp": "restores both \"chars\" (0x42aec3) and \"wav\" (0x42aed3)"
  },
  "music": "never passes the loader (the MP3 record: S_StartBackgroundTrack 0x45e2c0)"
 },
 "otherReaders": {
  "mp": "none: [0x1a20c90] is written at 0x45ca36 and read only at 0x45f643 and 0x45f673",
  "sp cinematic": "0x404a8f: when s_language is neither empty nor \"english\", video/jk05.roq and video/jk06.roq get the separate track sound/chars/video/cinematic_5 or _6 (flag 8, 0x404b4f), registered through S_RegisterSound (0x403c50), so the loader plays chr_d or chr_f; both exist only in the foreign folders",
  "sp censorship": "0x40a970 (reads sv_serverid and helpUsObi from the server settings): Cvar_Set (\"g_dismemberment\", \"0\") at 0x40aa43 when s_language is DEUTSCH, sp_language is 2 or ui_iscensored is 1"
 },
