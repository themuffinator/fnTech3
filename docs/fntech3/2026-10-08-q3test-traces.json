   },
   "positionTest": "every release has a brush position test storing fraction, allsolid, startsolid and contents (1.08 0x0040ea3b..0x0040ea54)"
  },
  "SV_LinkEntity": {
   "1.08": "0x0041f740 (game import LinkEntity, table built at 0x0041d058..0x0041d167): unlinks first; returns if inuse (+0xd0) is clear (0x0041f76b..0x0041f773); after CM_BoxLeafnums returns if no leaf had an area (0x0041fa80..0x0041fa88), before linkcount++ and linked = 1 (0x0041fb6b)",
   "1.02": "0x0041de30: unlinks first, skips the world (0x0041de5a), returns if inuse is clear (0x0041de66..0x0041de6e)",
