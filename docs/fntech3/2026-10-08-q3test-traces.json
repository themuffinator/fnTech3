{
 "date": "2026-10-08",
 "scope": "Q3Test collision and entity linking: every release's retail dedicated server against fnTech3, one synthetic game module",
 "commits": {
  "contentsRule": "7f5775a6121498ac6e2343ae03b8b021f78e4ed6",
  "linkRules": "the commit adding this revision of the record"
 },
 "platform": "Windows 11, x86 MSVC builds; dedicated servers on loopback, private desktop",
 "module": {
  "source": ".tmp/q3test-trace/trace_module.c (not committed)",
  "families": {
   "1.02, 1.03": "A (API 4, 33 imports, 20-word exports; the batteries run in SpawnEntities)",
   "1.05": "B (API 4, 33 imports, 18-word exports)",
   "1.06, 1.07": "C (API 6, 31 imports, 14-word exports)",
   "1.08": "D (API 6, 34 imports, 14-word exports)"
  },
  "worldBattery": "seeded LCG; three hulls (point, player box -15,-15,-24..15,15,32, random box up to 32) x two masks (1, -1) x three shapes (long random, vertical drop through the world, short <=48 units), 300 of each shape; then 1,500 point contents; pass entity 1023; every answer printed as raw float bits",
  "entityBattery": "a 32-unit box entity linked with inuse 0, 1, 0; every brush model k linked as entity 300+k with contents 1, moved by (8k, -4k, 2k) and, for even k, turned (pitch 5*(k%3), yaw 15k); its linked flags and bounds; 90 traces through the region the module computes for it (point and player box, masks 1 and -1); 200 box queries (EntitiesInBox in C/D, ContactEntities in A/B) around the models",
  "stamp": "the retail qagamex86.dll's PE TimeDateStamp copied in, which is how fnTech3 names a release; retail engines never read it",
  "botLibrary": "bot_enable 0; retail 1.08 tests it before GetBotAIAPI (0x41b494), which the C and D builds export as a stub"
 },
 "retailFacts": {
  "CM_TraceThroughBrush allSolid": {
   "1.08": "0x0040ece0; inside branch 0x0040eea9..0x0040eed3 stores startsolid (+0xc8), fraction 0 (+0xcc) and allsolid (+0xc4) only; contents (+0xf4) only on a hit, 0x0040ef4d",
   "storePatternEveryRelease": {
    "1.02": "0x0040d494 c8, 0x0040d4a2 cc, 0x0040d4a9 c4",
