  "finalRTCWProbeInstrumentation": {
    "sourceSha256": "05705004364ea26cf00eb5906cb47acf9372c17a6981d21ffe685acf00f273ae",
    "probeSourceSha256": "459fd9b1589b5bb08223d5ded77a1a7ba0eb17312da4d51ef35a67c7f30b6dc5",
    "additionalCommands": "\n    // Disposable instrumentation: the standing-authorized briefing Ready click only.\n    Cmd_AddCommand(\"fn_probe_ready\", []() {\n        static bool used=false;\n        if(used || !Com_GameIsRTCWSP() || cls.state!=CA_ACTIVE || !uivm ||\n           !(Key_GetCatcher()&KEYCATCH_UI) || !Cvar_VariableIntegerValue(\"cg_norender\") ||\n           (VM_Call(uivm,0,UI_GET_ACTIVE_MENU)!=UIMENU_BRIEFING &&\n            VM_Call(uivm,0,UI_GET_ACTIVE_MENU)!=UIMENU_PREGAME)) {\n            Com_Printf(\"ASPECT_PROBE ready refused\\n\");return;\n        }\n        used=true;\n        VM_Call(uivm,2,UI_MOUSE_EVENT,-640,-480);\n        VM_Call(uivm,2,UI_MOUSE_EVENT,620,470);\n        CL_KeyEvent(K_MOUSE1,qtrue,cls.realtime);\n        CL_KeyEvent(K_MOUSE1,qfalse,cls.realtime);\n        Com_Printf(\"ASPECT_PROBE ready clicked once\\n\");\n    });\n",
    "frameHook": "\nstatic void AspectProbeFrame() {\n    static unsigned started=0;\n    static int phase=0;\n    if(cls.state!=CA_ACTIVE || !cl.snap.valid || !Com_GameIsRTCW()) return;\n    const unsigned now=static_cast<unsigned>(Sys_Milliseconds());\n    if(!started) started=now;\n    const unsigned elapsed=now-started;\n    static bool equipped=false;\n    if(Com_GameIsRTCWSP() && !equipped && elapsed>=4000) {\n        Cbuf_AddText(\"weapon 3\\n\"); equipped=true;\n    }\n    if(phase==0 && elapsed>=1500) {\n        Cbuf_AddText(Com_GameIsRTCWSP() ? \"fn_probe_ready; give all; weapon 3\\n\" : \"team red; CloseLimboMenu\\n\"); ++phase;\n    }\n    if(phase==1 && elapsed>=8000) {\n        Com_Printf(\"ASPECT_PROBE frame time=%d paused=%d wait=%d norender=%d\\n\",cl.snap.serverTime,\n            Cvar_VariableIntegerValue(\"cl_paused\"),Cvar_VariableIntegerValue(\"cl_waitForFire\"),Cvar_VariableIntegerValue(\"cg_norender\"));\n        Cbuf_AddText(\"hud_reload; set cl_hudDump 1; screenshotPNG enabled\\n\"); ++phase;\n    }\n    if(phase==2 && elapsed>=9000) { Cbuf_AddText(\"set cl_hudAspect 0; set r_fovCorrection 0\\n\"); ++phase; }\n    if(phase==3 && elapsed>=9300) { Cbuf_AddText(\"screenshotPNG disabled\\n\"); ++phase; }\n    if(phase==4 && elapsed>=10000) { Cbuf_AddText(\"set cl_hudAspect 1; set r_fovCorrection 1\\n\"); ++phase; }\n    if(phase==5 && elapsed>=10300) { Cbuf_AddText(\"screenshotPNG restored\\n\"); ++phase; }\n    if(phase==6 && elapsed>=11000) { Cbuf_AddText(\"quit\\n\"); ++phase; }\n}\n",
    "scope": "One briefing Ready click per private process; no OS input or OS screen capture."
  }
}
