   "Init_AAS_Export": "0x004a7fc0; slot +0x10 0x004954b0, slot +0x14 0x00495540",
   "portalBranch": "0x004955f1 mov eax,[0x016de974] (portals); edx = cluster*20; ecx = portals - edx; 0x00495601 mov edx,[ecx+4] (frontcluster); ecx = frontcluster*20; sub eax,ecx; 0x0049560d mov eax,[eax+0xc] (portals[-frontcluster].clusterareanum[0])"
  },
  "readOffset": "for front cluster k the old read is 20k - 12 bytes before the portal table",
  "inferred": "each lump is a hunk block behind a four-byte tag (id's l_memory.c, kept in code/botlib/l_memory.cpp), so for k = 1 the word read is the one below the tag; what either retail engine returns for a portal area was not measured"
 },
