   "Init_AAS_Export": "0x00487b70; slot +0x10 AAS_PointAreaNum 0x004a9470, slot +0x14 AAS_PointReachabilityAreaIndex 0x004a94f0",
   "portalBranch": "0x004a955f lea ecx,[eax+eax*4]; shl ecx,2; mov ecx,[0x00c68e54] (portals); sub; mov eax,[eax+4] (frontcluster); 0x004a9574 lea edx,[eax+eax*4]; shl edx,2; sub ecx,edx; 0x004a957c mov esi,[ecx+0xc] (portals[-frontcluster].clusterareanum[0])"
  },
