  "contracts": {
    "renderer_api": 28,
    "ownership": "Validate entire handle/finite/capacity batch, then copy into existing frame-owned entities. No native pointers retained. Other-profile generic submissions clear IHV state. Null model allowed; unknown nonzero native tokens rejected.",
    "view_flags": "Native 0x2 hidden in primary, 0x4 hidden in portal, 0x800 omitted from ordinary surface submission; 0x400 uses primary camera axes, including secondary views. Raw bits remain separate from retail renderfx.",
    "depth": "Original 0x10 depth range is (0,0.3), restored to (0,1). Mapped to existing weapon-depth renderer path; no GPU comparison in this slice.",
    "origin": "0x40 projects oldorigin-origin in z,y,x order, stores float, multiplies by an unclamped fraction, stores float. Raster/ray MD3 paths apply the helper result; full native MD3 vertex/normal arithmetic and culling remain open.",
    "beam": "Exact special name *beam, separate model kind; six-sided radius-four ring, local-zero start, extrusion oldorigin-origin. Twelve unique vertices and twelve triangles preserve original strip closure and winding. White/red ONE/ONE material, no depth writes or sprite fog; surrounding entity transform supplies position/orientation.",
    "ray": "Same beam geometry/colors/indices and primary-camera facing axes. Exact flags/origin/oldorigin/axes/backlerp enter native dynamic signatures; other-profile signatures unchanged.",
    "retained_state": "Batches with 0x80 explicitly rejected: original skips transform AND lighting, retaining sorted prior state. Partial raster-only behavior is not accepted.",
    "lighting_observation_only": "With trace injected and no dynamic lights, any nonzero flags adds 32 to all RGB channels, then max-channel normalization to 255 if needed; no-world uses white first. Not implemented and not evidence of actual map-light sampling."
  },
