 "platform": "Windows 11, x86 builds (MSVC, debugoptimized, strict warnings) from git archive exports; servers bound to 127.0.0.1 with isolated folders; clients windowed on private desktops, without sound",
 "retail": {
  "stvoyHM.exe": {
   "sha256": "5b5b6e82ce7ac0d720a45ab1fa9df32930c846d6c51847fa0c158ebc86487dff",
   "WinMain": "0x440a05..0x440a5e: Sleep( 5 ) (0x440a1a) before every Com_Frame (0x440a39) while minimized or dedicated; timeBeginPeriod( 1 ) at 0x4404f3",
   "NET_Sleep": "0x440190: an empty function (ret)",
   "Com_Frame": "0x41c5c0: a dedicated server waits for 1 ms (0x41c6bf), running Com_EventLoop (0x41c6c4..0x41c6e9)",
   "SV_Frame": {
    "address": "0x4351a0",
    "fps": "0x43523b: sv_fps below 1 set to 10; tick 1000 / sv_fps (0x435252..0x435265)",
    "listenBotFrame": "0x43527e..0x435289: SV_BotFrame( svs.time + residual ) unless dedicated",
    "earlyReturn": "0x43529c..0x4352b4: dedicated and residual < frameMsec: NET_Sleep, return",
    "dedicatedBotFrame": "0x43537a..0x435393: SV_BotFrame( svs.time ) once, before the ticks",
    "ticks": "0x435396..0x4353c8: svs.time += frameMsec (0x4353a4), GAME_RUN_FRAME( svs.time )",
    "tail": "SV_CheckTimeouts 0x4353e3, SV_SendClientMessages 0x4353e8, SV_MasterHeartbeat 0x4353f2"
   },
   "SV_SendMessageToClient": {
    "deadline": "0x435478..0x43551d",
    "loopback": "0x435481..0x435494: nextSnapshotTime = svs.time - 1",
    "size": "0x435495..0x4354a0: message size held to 1500",
    "maxRate": "0x4354a5..0x4354df: sv_maxRate below 1000 set to 1000; rate held under it",
    "rateMsec": "0x4354e1..0x4354f2: ( size + 48 ) * 1000 / rate",
    "flag": "0x4354fb..0x435517: the larger of rateMsec and snapshotMsec; rateDelayed when rateMsec wins"
   },
   "SV_SendClientMessages": {
    "address": "0x435cf0",
    "deadline": "0x435d25..0x435d31: skip while svs.time < nextSnapshotTime",
    "fragments": "0x435d37..: a pending fragment is sent here, its deadline svs.time + rateMsec of what remains (held to 1500)"
   },
   "SV_UserinfoChanged": "0x4306ca..0x4307bb: LAN rate 99999; else rate held to 1000..90000, 3000 when absent; snaps held to 1..30, 50 ms when absent"
  },
  "stvoy.exe": {
   "sha256": "8f7ccadb52b4230689c5b3275177f7ec7060a30bfaa3ade4e7b3fb0cda0dff74",
   "sv_fps": "0x426633: below 1 set to 10"
  }
 },
