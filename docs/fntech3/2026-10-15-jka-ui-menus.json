 "fnBefore": {
  "host": "client_jka_cgame_host.hpp CG_OPENUIMENU mapped args[1] through FNTech3_JKAUIMenuToInternal (0..5 only) and dropped \"Jedi Academy cgame UI menu %ld is not served yet\" for the rest"
 },
 "fnDesign": {
  "request": "UI_SET_MODULE_MENU = 0x10003, an engine-only request beside UI_GET_ACTIVE_MENU, UI_CHECKEXECKEY and UI_WANTSBINDKEYS (code/ui/ui_public.h)",
  "boundary": "FNTech3_JKAUIExportOrdinal maps it to export 7 and FNTech3_JKAUIExportArgumentCount to one word (code/compat/jka_ui_exports.h); vm.c translates only UI_SET_ACTIVE_MENU, so the number reaches the module unchanged",
  "host": "CG_OPENUIMENU keeps its guards and calls VM_Call(uivm, 1, UI_SET_MODULE_MENU, args[1]); result 0",
  "removed": "FNTech3_JKAUIMenuToInternal",
  "engineRequests": "unchanged: the engine still names menus in its own vocabulary, translated to 0..5",
  "outOfRange": "forwarded unchanged, as retail forwards them; retail uix86.dll ignores numbers above 11 and negative ones",
  "partialInitialization": "refused before any module entry: a UI that is not ready (no uivm, UI_INIT unfinished, or an error in progress), not VM_UI, without an entry point, with structured exports, a 64-bit host, or a client game without an entry point. Retail fatals on a null VM and otherwise calls the module, which ignores the number while no menu is loaded.",
  "presentation": "The menus are the retail UI module's own; Fn draws them through its existing 2D, HUD and menu-aspect paths. No presentation feature is added or left out."
 },
