  "method": "pefile and Capstone over quakelive_steam.exe; addresses are virtual addresses; no retail code is incorporated",
  "connectionlessDispatcher": {
   "address": "0x4e4340",
   "takes": [
    "getchallenge -> 0x4df430",
    "connect -> 0x4e0750",
    "disconnect"
   ],
   "otherwise": "bad connectionless packet; no getinfo, getstatus, rcon or ipAuthorize"
  },
  "SV_PacketEvent": {
   "address": "0x4e4500",
   "rule": "returns while sv_serverType == 0 and the address type is not 2 (loopback), before out-of-band and in-game handling"
  },
  "sv_serverType": {
   "registration": "0x4e3b6a",
   "default": "0",
   "flags": "archive (1)",
   "pointer": "0x13e1818"
  },
  "SV_GetChallenge": {
   "address": "0x4df430",
   "rule": "sv_serverType == 1 and not Sys_IsLANAddress (0x4ee570): print \"Server is for LAN clients only.\" (0x4df476) and return; then the Steam auth token, then challengeResponse %i",
   "reads": "neither g_gametype nor ui_singlePlayerActive"
  },
  "g_gametype": {
   "pointer": "0x13e1804",
   "readAt": [
    "0x4682b2",
    "0x4688ab",
    "0x468b6b",
    "0x4de7e8 (training-arena command 0x4de050)",
    "0x4e375a"
   ],
   "mapCommand": "set from the chosen factory (0x4ddf62); no spmap"
  },
  "ui_singlePlayerActive": {
   "writes": [
    "0x4cc67e Com_Init \"0\"",
    "0x4b8c7a client",
    "0x4b8cfe client",
    "0x4b8d4f client",
    "0x4de00a SV_Map_f \"1\" when dedicated is 0",
    "0x4e4018 SV_Shutdown \"0\""
   ],
   "reads": "none in the engine"
  },
  "race": {
   "factory": "pak00.pk3 scripts/factories.txt \"race\", basegt race",
   "map": "campgrounds lists race in its arena"
  }
 },
 "reference": {
  "qlsrp": {
   "commit": "13df7762",
   "use": "reference observation only",
   "note": "src/code/server/server.h:282 reads 0 as public and 2 as offline; retail's SV_PacketEvent contradicts it"
  }
 },
