  "fnDesign": {
    "walk": "code/server/sv_snapshot.cpp SV_AddEntitiesVisibleFromPoint",
    "chain": "unchanged: every pass from the eye or a portal recurses into the portals it adds, bounded by the already-added test; SnapshotEntityNumbers::Add marks an entity added before its cap test, as quake3.exe does (0x43b8f6 before 0x43b8fe)",
    "rtcwCamera": "rtcw-sp/rtcw-mp only: when the viewer entity (frame ps.clientNum) has FNTECH3_RTCW_EF_VIEWING_CAMERA (0x40000) and the pass is the eye's, only SVF_PORTAL entities are added, each recursed with portal = true; nested passes walk as usual",
    "secondView": "Quake3e SVF_SELF_PORTAL2 (0x20000) is read for q3 and ql only, the profiles whose modules can query it (SV_GetValue SVF_SELF_PORTAL2_Q3E); it adds no portal view and runs at the end of each eye or portal pass, as in Quake3e. Before: honoured for every profile whose flags pass untranslated (jka-mp, jk2-mp, jka-sp, jk2-sp), where no retail walk reads it (jka-sp: 0x20000 is SVF_BBRUSH)",
    "range": "generic1 range unchanged; RTCW, ET and Elite Force adapters leave generic1 0, so it is inert there as their retail walks have none",
    "wolfetSelfPortal": "kept: expanded once per snapshot (wolfetSelfPortalAdded). Retail tests it on every pass and would recurse without end; the GPL game only clears the bit (inference for the retail module)",
    "frame": {
      "before": 5948,
      "after": 60,
      "unit": "bytes, MSVC debugoptimized fntech3.ded.pdb S_FRAMEPROC",
      "cause": "three sharedEntity_t locals plus the inlined ET proxy target (~2 KB each) per recursion; now two buffers in SnapshotEntityNumbers, the viewpoint copied before each recursion",
      "effect": "a chain about 170 portals deep exhausted the 1 MiB main stack; retail frames are 0x30-0x40 bytes"
    },
    "depthGuard": "none added: depth is at most the number of portal entities (1,023), retail's bound too"
  },
