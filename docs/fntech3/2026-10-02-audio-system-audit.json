  "worktree": "Dirty before the audit; pre-existing edits preserved. Source fingerprints include the complete tested files, not only this task's hunks.",
  "implementations": {
    "stream_lifecycle": "Rewind cleared/stopped sources, retain newly submitted PCM during underrun, preserve deferred queues.",
    "music": "Drain natural EOF; retry interpolation tails and one bounded decoded chunk; bound empty loops; clear pending data on replacement/stop.",
    "surround_fallback": "Fall back only with an empty queue; preserve accepted audio and conversion state on transient rejection, including unsubmitted interpolation lookahead if both uploads fail.",
    "pcm": "Native-endian decoded PCM16; unaligned reads; finite saturation; multiply signed PCM8 instead of shifting.",
    "stream_gain": "Keep integer phase and interpolation history through gain changes by scaling input samples; sanitize invalid OpenAL gain; reset cleared queue duration metadata on query failure.",
    "raw_idle": "Drain raw-stream lookahead while retaining phase/left support across bursts; skip conversion-state copies when no PCM remains. The production update fixture verifies 100 short bursts and zero allocations over 10,000 subsequent idle updates.",
    "source_quality": "Runtime-named AL_SOFT_source_resampler selection: balanced sinc up to 24 taps by default, smallest sinc for fast, largest for best, explicit library default; validate optional APIs and restore the queried default on reused sources when falling back.",
    "ritual_score": "Separate decoder exhaustion from playback completion; native 44.1-kHz PCM preserved, shared band-limited converter for other rates; retain converted PCM/filter state through moves/parking, loops and EOF; playback-based remaining time; finite gains, null/unaligned PCM safety.",
    "mohaa_score": "Bound empty/skipped loops; preserve filter/phase across playable loops; retain EOF and failed/incompatible reopen tails; subtract decode/converter read-ahead from playback positions/remaining time; triggered whole-file loops distinct from existing soundtrack offset; finite gain and null/unaligned PCM safety.",
    "score_idle_stream": "Ritual/MOHAA mix codecs report EOF when no tracks are playing, letting the backend drain accepted PCM and stop silent-stream processing. Later active tracks use the existing reattachment path.",
    "alsa": "Advance direct/async ring cursors by frames actually accepted; stop zero/error transfers.",
    "resampling": "Exact identity PCM; independently written Blackman-windowed sinc in both directions, 95%-of-lower-Nyquist cutoff/64 lobes, immutable shared phase tables, single output reserve and specialized contiguous mono/stereo/six-channel loops."
  },
