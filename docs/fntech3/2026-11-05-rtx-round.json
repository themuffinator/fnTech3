 "fixes": [
  "still-view history stored as exact half floats by unbiased stochastic rounding (rt_half_dither.glsl)",
  "still view keeps its plain average as history and filters with the average's variance",
  "motion vector includes the accumulation jitter",
  "history length capped at 2048 (half-float integers)",
  "rtx_rt_mis 0 double counting of surface lights and sky in glossy reflections",
  "unsampled glowing surfaces keep their glow in reflections (u_primitiveLights lookup, bounds-checked)",
  "no GGX reflection where N.V <= 0; Fresnel base clamped",
  "specGloss F0 linearised under linear light",
  "frame index wrapped below 2^23 for the float uniform and the denoiser phase",
  "image-average cache reset with the material table; lights reuse the averages",
  "failed light build keeps the lighting mode and sky colour",
  "emissive surface lights follow shader remaps",
  "zero-area autosprite surface light skipped",
  "motion records keyed by material-table rebuilds, not growth",
  "hardware backend: dynamic BLASes abandoned when a frame's plan fails or its commands are discarded",
  "discarded frame resets history, camera, tone clear and timestamps",
  "texture table rewritten when an image view is replaced",
  "failed world build retried after a doubling delay (0.5 s to 64 s), view left to raster meanwhile; build arrays freed",
  "lighting change handled before patch-shadow change, materials rebuilt after a failed world, pending on a failed wait"
 ],
 "optimisations": [
  "compute trace workgroups grouped by the indirect divisor's pixel class (RT_TraceGroupDivisor)",
  "glossy reflection hits take one light sample of four candidates; liquid delta paths keep sixteen",
  "compute slab test with one fma per slab",
  "alpha-test LOD skips footprint arithmetic without a footprint"
 ],
