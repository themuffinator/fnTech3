   "cameraShakeCase": "jamp.exe 0x40b2ca..0x40b389 (switch table 0x40b5e8 indexed by family - 1; CameraShake is family 12, entry 11): life +0x3c/+0x40, radius +0xec/+0xf0, intensity +0x234/+0x238, each drawn by 0x444230 only when its ends differ; life and radius truncated by _ftol 0x539584; intensity kept as a float; 0x40c560(origin [esp+0x40] in ecx; 0x12d0850, intensity, radius, life)",
   "publish": "jamp.exe 0x40c560: shared buffer [0xb25c98] +0 origin, +0xc intensity, +0x10 radius, +0x14 time; then 0x44ae90 (VM_Call) on cgvm [0x8af0fc] with export 0x1f; ret 0x10",
   "exportDispatch": "cgamex86.dll vmMain 0x300425a0 table 0x30042854 entry 31 -> 0x3004281c: CG_DoCameraShake 0x30062c70(0x30740800, [+0xc], [+0x10], [+0x14])",
   "doCameraShake": "cgamex86.dll 0x30062c70: dir = refdef.vieworg (0x306f9f7c) - origin; dist = VectorNormalize 0x30068d60; dist > radius returns; intensity *= 1 - dist/radius (1.0f at 0x3007d114); above 16.0f (0x30086088) it is 16; stores intensity 0x304fe268, duration 0x304fe26c, start = cg.time (0x306f9240) at 0x304fe270",
   "updateShake": "cgamex86.dll 0x30062990(vieworg, viewangles), called once per frame at 0x30063b9e: duration <= 0 returns; past start + duration clears all three; FOV terms at 0x304fe260/0x304fe264 set to 90 so the factor is 1; scale = 1 - elapsed/duration; three draws ((rand 0x30072a36 & 0x7fff) / 32767 - 0.5) * 2 * intensity * scale added to the origin; two fresh draws added to pitch and yaw; roll receives the third origin draw",
   "afterShake": "cgamex86.dll S_Respatialize (import 44 via 0x3005e550, called at 0x30063cf7) with the shaken refdef origin and axis; no cvar gates the shake",
   "viewpos": "cgamex86.dll 0x30022390 prints \"%s (%i %i %i) : %i\" (0x300896b4) from refdef.vieworg and yaw, each truncated"
  },
