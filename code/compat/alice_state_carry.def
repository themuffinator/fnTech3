/* How every networked member of Alice's two records crosses into this
 * engine's, generated alongside qcommon/alice_state.h so the two cannot
 * disagree. A member is either mapped onto one this engine already has, or
 * carried in the extension under its own name; the generator will not emit
 * this file unless the two sets cover a delta table exactly.
 *
 *   FNTECH3_ALICE_ENTITY_MAP( external, internal )
 *   FNTECH3_ALICE_ENTITY_CARRY( member )
 *   FNTECH3_ALICE_ENTITY_CARRY_ARRAY( member, count )
 *
 * and the same three for the player state. The bone modifiers and the two
 * masked blocks are moved by hand in the adapter, because each is a record
 * rather than a member. Intentionally no include guard: consumed as a table.
 */

#ifdef FNTECH3_ALICE_ENTITY_MAP
FNTECH3_ALICE_ENTITY_MAP( eType, eType )
FNTECH3_ALICE_ENTITY_MAP( eFlags, eFlags )
FNTECH3_ALICE_ENTITY_MAP( pos.trType, pos.trType )
FNTECH3_ALICE_ENTITY_MAP( pos.trTime, pos.trTime )
FNTECH3_ALICE_ENTITY_MAP( pos.trDuration, pos.trDuration )
FNTECH3_ALICE_ENTITY_MAP( pos.trBase[0], pos.trBase[0] )
FNTECH3_ALICE_ENTITY_MAP( pos.trBase[1], pos.trBase[1] )
FNTECH3_ALICE_ENTITY_MAP( pos.trBase[2], pos.trBase[2] )
FNTECH3_ALICE_ENTITY_MAP( pos.trDelta[0], pos.trDelta[0] )
FNTECH3_ALICE_ENTITY_MAP( pos.trDelta[1], pos.trDelta[1] )
FNTECH3_ALICE_ENTITY_MAP( pos.trDelta[2], pos.trDelta[2] )
FNTECH3_ALICE_ENTITY_MAP( apos.trType, apos.trType )
FNTECH3_ALICE_ENTITY_MAP( apos.trTime, apos.trTime )
FNTECH3_ALICE_ENTITY_MAP( apos.trDuration, apos.trDuration )
FNTECH3_ALICE_ENTITY_MAP( apos.trBase[0], apos.trBase[0] )
FNTECH3_ALICE_ENTITY_MAP( apos.trBase[1], apos.trBase[1] )
FNTECH3_ALICE_ENTITY_MAP( apos.trBase[2], apos.trBase[2] )
FNTECH3_ALICE_ENTITY_MAP( apos.trDelta[0], apos.trDelta[0] )
FNTECH3_ALICE_ENTITY_MAP( apos.trDelta[1], apos.trDelta[1] )
FNTECH3_ALICE_ENTITY_MAP( apos.trDelta[2], apos.trDelta[2] )
FNTECH3_ALICE_ENTITY_MAP( netorigin[0], origin[0] )
FNTECH3_ALICE_ENTITY_MAP( netorigin[1], origin[1] )
FNTECH3_ALICE_ENTITY_MAP( netorigin[2], origin[2] )
FNTECH3_ALICE_ENTITY_MAP( origin2[0], origin2[0] )
FNTECH3_ALICE_ENTITY_MAP( origin2[1], origin2[1] )
FNTECH3_ALICE_ENTITY_MAP( origin2[2], origin2[2] )
FNTECH3_ALICE_ENTITY_MAP( netangles[0], angles[0] )
FNTECH3_ALICE_ENTITY_MAP( netangles[1], angles[1] )
FNTECH3_ALICE_ENTITY_MAP( netangles[2], angles[2] )
FNTECH3_ALICE_ENTITY_MAP( constantLight, constantLight )
FNTECH3_ALICE_ENTITY_MAP( loopSound, loopSound )
FNTECH3_ALICE_ENTITY_MAP( modelindex, modelindex )
FNTECH3_ALICE_ENTITY_MAP( frame, frame )
FNTECH3_ALICE_ENTITY_MAP( clientNum, clientNum )
FNTECH3_ALICE_ENTITY_MAP( groundEntityNum, groundEntityNum )
FNTECH3_ALICE_ENTITY_MAP( solid, solid )
#endif

