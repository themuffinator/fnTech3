/* Jedi Outcast multiplayer, measured. Every row below was read out of the
 * retail engine's own tables and writers, never from a source release:
 *
 *   entityState_t   from jk2mp.exe's entity delta table at file offset
 *                   0xf5ab0, which names every four-byte slot from 4 to
 *                   292 with no gap and gives the width each is sent at.
 *                   A member sent at zero bits is a float.
 *   trajectory_t    the six members the table names inside pos and apos.
 *
 * FNTECH3_JK2_WIRE_RECORD(record, size) and
 * FNTECH3_JK2_WIRE_FIELD(record, member, offset, size, kind), with kind
 * 0 integer, 1 floating point, 2 a nested record. */
#ifndef FNTECH3_JK2_WIRE_RECORD
#define FNTECH3_JK2_WIRE_RECORD(record, size)
#endif
#ifndef FNTECH3_JK2_WIRE_FIELD
#define FNTECH3_JK2_WIRE_FIELD(record, member, offset, size, kind)
#endif

FNTECH3_JK2_WIRE_RECORD(usercmd_t, 28)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, serverTime, 0, 4, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, angles, 4, 12, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, buttons, 16, 4, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, weapon, 20, 1, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, forcesel, 21, 1, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, invensel, 22, 1, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, generic_cmd, 23, 1, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, forwardmove, 24, 1, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, rightmove, 25, 1, 0)
FNTECH3_JK2_WIRE_FIELD(usercmd_t, upmove, 26, 1, 0)

FNTECH3_JK2_WIRE_RECORD(trajectory_t, 36)
FNTECH3_JK2_WIRE_FIELD(trajectory_t, trType, 0, 4, 0)
FNTECH3_JK2_WIRE_FIELD(trajectory_t, trTime, 4, 4, 0)
FNTECH3_JK2_WIRE_FIELD(trajectory_t, trDuration, 8, 4, 0)
FNTECH3_JK2_WIRE_FIELD(trajectory_t, trBase, 12, 12, 1)
FNTECH3_JK2_WIRE_FIELD(trajectory_t, trDelta, 24, 12, 1)

FNTECH3_JK2_WIRE_RECORD(entityState_t, 296)
FNTECH3_JK2_WIRE_FIELD(entityState_t, number, 0, 4, 0)
