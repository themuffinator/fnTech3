/* ET's tag carries its own axis, where RTCW's MDS tag carries a torso weight.
 * These sizes are each record's own length, not a stride: a surface and a tag
 * both carry variable-length data and are chained by their ofsEnd, and a vertex
 * is followed by as many weights as it claims. Only the fixed part is tabled. */
FNTECH3_WOLFET_MODEL_RECORD(mdmTag_t, 128, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmTag_t, name, 0, 64)
FNTECH3_WOLFET_MODEL_FIELD(mdmTag_t, axis, 64, 36)
FNTECH3_WOLFET_MODEL_FIELD(mdmTag_t, boneIndex, 100, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmTag_t, offset, 104, 12)
FNTECH3_WOLFET_MODEL_FIELD(mdmTag_t, numBoneReferences, 116, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmTag_t, ofsBoneReferences, 120, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmTag_t, ofsEnd, 124, 4)

FNTECH3_WOLFET_MODEL_RECORD(mdmVertex_t, 44, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmVertex_t, normal, 0, 12)
FNTECH3_WOLFET_MODEL_FIELD(mdmVertex_t, texCoords, 12, 8)
FNTECH3_WOLFET_MODEL_FIELD(mdmVertex_t, numWeights, 20, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmVertex_t, weights, 24, 20)

FNTECH3_WOLFET_MODEL_RECORD(mdmWeight_t, 20, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmWeight_t, boneIndex, 0, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmWeight_t, boneWeight, 4, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmWeight_t, offset, 8, 12)

FNTECH3_WOLFET_MODEL_RECORD(mdmTriangle_t, 12, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmTriangle_t, indexes, 0, 12)

FNTECH3_WOLFET_MODEL_RECORD(mdmLOD_t, 12, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmLOD_t, numSurfaces, 0, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmLOD_t, ofsSurfaces, 4, 4)
FNTECH3_WOLFET_MODEL_FIELD(mdmLOD_t, ofsEnd, 8, 4)

