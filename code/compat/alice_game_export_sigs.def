/* Copyright (C) 2026 fnTech3 contributors. GPL-2.0-or-later.
 *
 * Alice's 26 game export slots, typed.
 *
 * FNTECH3_ALICE_GAME_EXPORT_SIG( slot, name, kind, type, params, evidence )
 *
 * The frozen shape of every slot, read statically out of retail alice.exe,
 * base/fgamex86.dll and base/cgamex86.dll (SHA-256 8aa22917..., ae5a5727...,
 * fa70feb1...; nothing was run). `kind` is
 *
 *   FUNCTION  a function: `type` is its return type and `params` its
 *             parenthesised parameter list
 *   VALUE     a value the slot itself holds: `type` is that value's type
 *   ABSENT    no instruction in the module writes the slot, so it is never called
 *
 * Types are fixed-width: int (handles, qboolean and long included), float,
 * pointers, and unsigned char or unsigned short where retail reads or returns
 * only that width. A record returned by value is written as MSVC passes it, a
 * hidden first pointer returned in eax. Every function is __cdecl (QDECL):
 * each one ends in a bare `ret`.
 *
 * `evidence` names what fixes the shape: E the engine's side (alice.exe's own calls through the table it keeps at 0x00ac0e08), M
 * the module's side (the export's body in fgamex86.dll), S the member at that position in Ritual's
 * F.A.K.K.2 v1.02 SDK, read for reference only -- a hypothesis E and M
 * confirm, never text taken from it. The slot names are the ones
 * alice_game_exports.def already carries. The comment on each row is the export in fgamex86.dll.
 *
 * fntech3::alice::module checks every function this engine serves or calls
 * through a slot against its row, by ABI class (alice_module_abi.h); see
 * docs/fntech3/2026-10-08-alice-module-signatures.md.
 */

FNTECH3_ALICE_GAME_EXPORT_SIG(   0, apiversion,            VALUE,    int, ( void ), EMS )
FNTECH3_ALICE_GAME_EXPORT_SIG(   1, Init,                  FUNCTION, void, ( int, int ), EMS ) /* 0x100a3690 */
FNTECH3_ALICE_GAME_EXPORT_SIG(   2, Shutdown,              FUNCTION, void, ( void ), EMS ) /* 0x100a3610 */
FNTECH3_ALICE_GAME_EXPORT_SIG(   3, Cleanup,               FUNCTION, void, ( void ), EMS ) /* 0x100a35a0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(   4, SpawnEntities,         FUNCTION, void, ( const char *, const char *, int ), EMS ) /* 0x100a3970 */
FNTECH3_ALICE_GAME_EXPORT_SIG(   5, ClientConnect,         FUNCTION, const char *, ( int, int ), EMS ) /* 0x100a57e0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(   6, ClientBegin,           FUNCTION, void, ( void *, void * ), EMS ) /* 0x100a5380 */
FNTECH3_ALICE_GAME_EXPORT_SIG(   7, ClientUserinfoChanged, FUNCTION, void, ( void *, const char * ), EMS ) /* 0x100a54b0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(   8, ClientDisconnect,      FUNCTION, void, ( void * ), EMS ) /* 0x100a5980 */
FNTECH3_ALICE_GAME_EXPORT_SIG(   9, ClientCommand,         FUNCTION, void, ( void * ), EMS ) /* 0x100af390 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  10, ClientThink,           FUNCTION, void, ( void *, void * ), EMS ) /* 0x100a52e0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  11, BotBegin,              ABSENT,   void, ( void ), MS )
FNTECH3_ALICE_GAME_EXPORT_SIG(  12, BotThink,              ABSENT,   void, ( void ), MS )
FNTECH3_ALICE_GAME_EXPORT_SIG(  13, PrepFrame,             ABSENT,   void, ( void ), MS )
FNTECH3_ALICE_GAME_EXPORT_SIG(  14, RunFrame,              FUNCTION, void, ( int, int ), EMS ) /* 0x100a4fc0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  15, ConsoleCommand,        FUNCTION, int, ( void ), EMS ) /* 0x100af320 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  16, WritePersistant,       FUNCTION, void, ( const char * ), EMS ) /* 0x100a3bd0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  17, ReadPersistant,        FUNCTION, int, ( const char * ), EMS ) /* 0x100a3b60 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  18, WriteLevel,            FUNCTION, void, ( const char *, int ), EMS ) /* 0x100a47a0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  19, ReadLevel,             FUNCTION, int, ( const char * ), EMS ) /* 0x100a47d0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  20, LevelArchiveValid,     FUNCTION, int, ( const char * ), EMS ) /* 0x100a47f0 */
FNTECH3_ALICE_GAME_EXPORT_SIG(  21, gentities,             VALUE,    void *, ( void ), EMS )
FNTECH3_ALICE_GAME_EXPORT_SIG(  22, gentitySize,           VALUE,    int, ( void ), EMS )
