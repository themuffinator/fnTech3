/* Enemy Territory key numbers, recorded from its own ui/keycodes.h. All 110
 * are Quake III's, which RTCW kept as well, so this file names RTCW's frozen
 * table rather than repeating the same numbers; neither game's table can now
 * drift away from the other's unobserved.
 * ET stops at K_AUX16 and then names a K_LAST_KEY terminator, which is a
 * count rather than a key and is deliberately absent from both.
 * Intentionally no include guard: used for frozen constants and both mappings. */
#define FNTECH3_RTCW_KEY( name, number ) FNTECH3_WOLFET_KEY( name, number )
#include "rtcw_keycodes.def"
#undef FNTECH3_RTCW_KEY
