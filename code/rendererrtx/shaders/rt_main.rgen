#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require

// Path tracer ray generation: the per-pixel work of rt_path.glsl, tracing
// through the ray-tracing pipeline.

#include "rt_common.glsl"
#include "rt_bindings.glsl"
#include "rt_material.glsl"
#include "rt_geometry.glsl"
#include "rt_trace_hw.glsl"
#include "rt_path.glsl"

void main()
{
	rt_path_main(ivec2(gl_LaunchIDEXT.xy), vec2(gl_LaunchSizeEXT.xy));
}
