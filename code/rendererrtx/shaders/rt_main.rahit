#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Any hit for masked geometry (each class BLAS's second geometry): Quake III
// face culling and the shader's alpha test (rt_hit_accepted). It reads no
// payload, so radiance and shadow rays share it.

#include "rt_common.glsl"
#include "rt_bindings.glsl"
#include "rt_material.glsl"
#include "rt_geometry.glsl"

hitAttributeEXT vec2 bary;

void main()
{
	RtTriangle tri = rt_fetch_triangle(gl_InstanceCustomIndexEXT, uint(gl_GeometryIndexEXT), uint(gl_PrimitiveID));
	// instances flip facing to Quake's clockwise front faces
	bool front = gl_HitKindEXT == gl_HitKindFrontFacingTriangleEXT;
	if (!rt_hit_accepted(tri, bary, front, gl_WorldRayDirectionEXT)) {
		ignoreIntersectionEXT;
	}
}
